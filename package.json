    "@tanstack/react-virtual": "^3.14.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.6",
    "date-fns": "^4.4.0",
    "ky": "^2.1.0",
    "lucide-react": "^1.43.0",
    "next": "16.3.4",
    "next-intl": "^4.14.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
