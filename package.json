{
  "name": "doctor_ali_clinic_next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src --max-warnings=0",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"config/**/*.mjs\" \"*.{json,md,mjs,ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"config/**/*.mjs\"",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run check:contrast && npm run build",
    "analyze": "ANALYZE=true next build",
    "prepare": "husky",
    "check:contrast": "python3 scripts/check-contrast.py src/app/globals.css"
  },
  "dependencies": {
